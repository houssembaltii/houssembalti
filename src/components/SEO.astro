---
import { SEO as AstroSEO } from 'astro-seo';
import { SITE } from '@/lib/constants';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${SITE.name} | ${SITE.title}`,
  description = SITE.description,
  image = new URL("/og-image.png", Astro.site).toString()
} = Astro.props;

---

<AstroSEO
  title={title}
  description={description}
  openGraph={{
    basic: {
      title: title,
      type: "website",
      image: image,
      url: Astro.url
    }
  }}
 twitter={{
    card: "summary_large_image",
    title: title ?? "",
    description: description ?? "",
    image: image,
    imageAlt: `${SITE.name} - ${SITE.title}`,
  }}
/>
