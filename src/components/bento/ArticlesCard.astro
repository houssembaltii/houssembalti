---
import BentoCard from "./BentoCard.astro";
---

<BentoCard class="md:col-span-12 lg:col-span-5 relative overflow-hidden min-h-[160px] flex flex-col justify-between">
  <div class="relative z-10 h-full flex flex-col">
    <div class="flex items-center justify-between mb-8">
      <span class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground font-semibold">
        Articles
      </span>
      <span class="px-2 md:px-3 py-0.5 md:py-1 bg-secondary text-primary text-[9px] md:text-[10px] font-bold tracking-widest rounded uppercase">Coming Soon</span>
    </div>
    <div class="flex flex-col gap-3 md:gap-4 opacity-20 grayscale mt-auto pointer-events-none select-none">
      <div class="h-3 md:h-4 bg-border/40 rounded w-full"></div>
      <div class="h-3 md:h-4 bg-border/40 rounded w-3/4"></div>
      <div class="h-3 md:h-4 bg-border/40 rounded w-1/2"></div>
    </div>
  </div>
  <div class="absolute -right-4 -bottom-4 w-24 md:w-32 h-24 md:h-32 bg-primary/5 blur-2xl md:blur-3xl rounded-full pointer-events-none"></div>
</BentoCard>
