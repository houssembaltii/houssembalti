---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["bg-card border border-border rounded-xl p-6 md:p-8 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] active:bg-secondary active:border-primary/25 md:hover:bg-secondary md:hover:border-primary/25", className]}>
  <slot />
</div>
