---
import { EXPERIENCES } from "@/lib/constants";
import BentoCard from "./BentoCard.astro";
---

<BentoCard class="md:col-span-6 lg:col-span-4">
  <span class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground mb-6 block font-semibold">
    Current Experience
  </span>
  <div class="flex flex-col gap-6">
    {
      EXPERIENCES.map((e) => (
        <a
          href={e.href}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center md:items-start gap-4 group"
        >
          <div class="shrink-0">
            <div class="w-12 h-12 md:w-10 md:h-10 rounded-lg bg-secondary flex items-center justify-center overflow-hidden border border-border/20">
              <img alt={e.logoAlt} class="w-full h-full object-cover" src={e.logo} />
            </div>
          </div>
          <div class="flex-1">
            <h3 class="text-base md:text-lg font-bold text-foreground group-hover:text-primary group-active:text-primary transition-colors leading-tight">{e.role}</h3>
            <p class="text-muted-foreground text-xs md:text-sm">{e.org}</p>
            {e.period && (
              <p class="text-muted-foreground/60 text-[10px] md:text-xs mt-1">{e.period}</p>
            )}
          </div>
        </a>
      ))
    }
  </div>
</BentoCard>
