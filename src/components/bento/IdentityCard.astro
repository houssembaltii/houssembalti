---
import { SITE } from "@/lib/constants";
import BentoCard from "./BentoCard.astro";
---

<BentoCard class="md:col-span-12 lg:col-span-8 md:row-span-2 relative overflow-hidden group flex flex-col">
  <div class="relative z-10 flex flex-col h-full">
    <div class="mb-auto">
      <span class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground mb-6 block font-semibold">
        Identity
      </span>
      <div class="flex flex-col gap-6 mb-6 md:flex-row md:items-end md:mb-8">
        <img
          src="/houssem-balti.png"
          alt={SITE.name}
          class="w-32 h-32 md:w-48 md:h-48 rounded-lg md:rounded-xl object-cover object-top border border-border/30 md:border-2 shrink-0"
        />
        <div class="md:pb-2">
          <h1 class="text-3xl md:text-6xl font-bold tracking-tight md:tracking-tighter leading-none text-primary mb-2">
            {SITE.name}.
          </h1>
          <p class="text-sm md:text-lg text-muted-foreground font-medium tracking-tight">
            {SITE.title}
          </p>
        </div>
      </div>
      <h2 class="text-xl md:text-3xl font-bold tracking-tight md:tracking-tighter text-foreground max-w-xl leading-snug">
        {SITE.tagline}
      </h2>
    </div>
  </div>
</BentoCard>
