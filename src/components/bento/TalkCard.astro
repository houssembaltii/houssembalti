---
import { TALKS } from "@/lib/constants";
import BentoCard from "./BentoCard.astro";
---

<BentoCard class="md:col-span-12 lg:col-span-7 flex flex-col justify-between relative overflow-hidden">
  <div class="relative z-10 w-full">
    <span class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground mb-6 block font-semibold">Talks</span>
    <div class="space-y-4 md:space-y-6">
      {
        TALKS.map((talk) => (
          <div class="flex flex-col gap-1 md:flex-row md:items-center md:justify-between md:gap-2">
            <div>
              <h3 class="text-lg md:text-xl font-bold tracking-tight text-foreground leading-tight">{talk.title}</h3>
              <p class="text-muted-foreground text-xs md:text-sm font-medium">{talk.event}</p>
            </div>
            <div class="text-[9px] md:text-[11px] font-bold tracking-widest text-muted-foreground/60 uppercase shrink-0">
              {talk.date} &bull; {talk.location}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</BentoCard>
