---
import Layout from "@/layouts/Layout.astro";
import SEO from "@/components/SEO.astro";
import Hero from "@/components/home/Hero.astro";
import Tagline from "@/components/home/Tagline.astro";
import AtWork from "@/components/home/AtWork.astro";
import Talks from "@/components/home/Talks.astro";
import Elsewhere from "@/components/home/Elsewhere.astro";
import { SITE } from "@/lib/constants";
---

<Layout>
  <SEO slot="seo" title={`${SITE.name}, ${SITE.title}`} />
  <main class="min-h-screen px-6 py-20 md:py-28 flex flex-col items-center">
    <article class="w-full max-w-md mx-auto">
      <Hero delay={0} />
      <Tagline delay={140} />
      <AtWork delay={280} />
      <Talks delay={420} />
      <Elsewhere delay={560} />
    </article>
  </main>
</Layout>
